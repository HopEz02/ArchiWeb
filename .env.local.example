# Copy this file to .env.local and fill in real values.
# .env.local must never be committed — it's already covered by Next.js's
# default .gitignore for env files.

# Resend (transactional email for the contact form) — server-only, secret.
RESEND_API_KEY=
# Where inquiry emails should be delivered.
CONTACT_EMAIL_TO=

# Upstash Redis (rate limiting for the contact form) — server-only, secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cal.com booking — public identifiers, safe to expose in the browser.
# These just say which calendar to render, not how to access it.
NEXT_PUBLIC_CAL_USERNAME=
NEXT_PUBLIC_CAL_EVENT_SLUG=
